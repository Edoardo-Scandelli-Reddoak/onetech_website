# Web3Forms access key (public by design: Web3Forms free plan only accepts browser submissions).
# Without it, requests are still validated by /api/contact and saved to data/contact-requests.jsonl.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Django backoffice (../backend). Leave empty to skip it.
CONTACTS_API_URL=http://127.0.0.1:8000/api/contacts/
CONTACTS_API_TOKEN=onetech-dev-token

# Google Analytics (optional): loaded ONLY after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=
